#!/bin/bash

# ==========================================================
# Preservation Container - Welcome & Help
# ==========================================================

# Couleurs ANSI
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RESET='\033[0m'
    CYAN='\033[1;36m'
    GREEN='\033[1;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[1;34m'
    WHITE='\033[1;37m'
    GRAY='\033[0;90m'
else
    RESET=''
    CYAN=''
    GREEN=''
    YELLOW=''
    BLUE=''
    WHITE=''
    GRAY=''
fi

# Affichage de l'aide
display-help() {

    printf "\n"

    printf "${CYAN}"
    printf '  ╔══════════════════════════════════════════════════╗\n'
    printf '  ║          PRESERVATION CONTAINER                  ║\n'
    printf '  ║             Digital Preservation                 ║\n'
    printf '  ╚══════════════════════════════════════════════════╝\n'
    printf "${RESET}"

    printf "\n"

    printf "${GREEN}"
    printf "  Bienvenue dans votre environnement de préservation !\n"
    printf "${RESET}"

    printf "\n"
    printf "  Votre espace de travail est prêt.\n"
    printf "  Vous pouvez commencer à analyser vos fichiers.\n"

    printf "${BLUE}"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "  📁  RÉPERTOIRES\n"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "${RESET}"

    printf "  ${YELLOW}/mnt/input${RESET}    Fichiers sources\n"
    printf "  ${YELLOW}/mnt/output${RESET}   Fichiers générés et résultats\n"
    printf "  ${YELLOW}/work${RESET}         Espace de travail courant\n"

    printf "${BLUE}"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "  🔧  OUTILS DE PRÉSERVATION\n"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "${RESET}"

    printf "  ${WHITE}file${RESET}          Identification des fichiers\n"
    printf "  ${WHITE}droid${RESET}         Identification PRONOM\n"
    printf "  ${WHITE}sf${RESET}            Identification Siegfried\n"
    printf "  ${WHITE}tika${RESET}          Extraction de métadonnées et de textes\n"
    printf "  ${WHITE}exiftool${RESET}      Extraction de métadonnées images\n"
    printf "  ${WHITE}mediainfo${RESET}     Extraction de métadonnées audiovisuelles\n"
    printf "  ${WHITE}jhove${RESET}         Validation de formats\n"
    printf "  ${WHITE}verapdf${RESET}       Validation PDF\n"
    printf "  ${WHITE}epubcheck${RESET}     Validation EPUB\n"
    printf "  ${WHITE}ffmpeg${RESET}        Traitement audio et vidéo\n"
    printf "  ${WHITE}flac${RESET}          Traitement fichier FLAC\n"
    printf "  ${WHITE}mp3val${RESET}        Validation fichier MP3\n"
    printf "  ${WHITE}jpylyzer${RESET}      Validation JPEG 2000\n"
    printf "  ${WHITE}pdfbox${RESET}        Manipulation PDF\n"
    printf "  ${WHITE}pdftk${RESET}         Exploration PDF\n"
    printf "  ${WHITE}bagit${RESET}         Création de packages BagIt\n"
    printf "  ${WHITE}jwattools${RESET}     Manipulation de fichiers WARC\n"
    printf "  ${WHITE}7z${RESET}            Manipulation de fichiers archive\n"
    printf "  ${WHITE}jq${RESET}            Manipulation de fichiers JSON\n"
    printf "  ${WHITE}fq${RESET}            Manipulation de fichiers binaires\n"
    printf "  ${WHITE}czkawka${RESET}       Recherche de doublons\n"
    
    czkawka-cli

    printf "${BLUE}"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "  🛠️  SCRIPTS D'ACTION\n"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "${RESET}"

    printf "  ${WHITE}help-container${RESET}     Affichage de ce menu d'aides\n"
    printf "  ${WHITE}start-session${RESET}      Démarre une session de travail\n"
    printf "  ${WHITE}tool-versions${RESET}      Affiche les versions des outils\n"
    printf "  ${WHITE}tika-analyze${RESET}       Lancement d'une analyse par tika\n"
    printf "  ${WHITE}mime-distribution${RESET}  Génération d'un graphique\n"

    printf "${YELLOW}"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "  💡  CONSEIL\n"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "${RESET}"

    printf "  Initialiser une session de travail avec ${GREEN}source start-session${RESET}\n"
    printf "  et utiliser les variables d'environnement ${YELLOW}\${SESSION_ID}${RESET}\n"
    printf "  et ${YELLOW}\${REPORT_DIR}${RESET} pour générer vos fichiers résultats.\n"

    printf "${CYAN}"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "       Bonne session de préservation !\n"
    printf "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "${RESET}"

    printf "\n"
}

display-help

